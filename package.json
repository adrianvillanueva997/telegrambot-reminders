{
	"name": "telegrambot-reminders",
	"version": "1.0.0",
	"description": "A simple telegram bot that sends reminders to a private group chat",
	"main": "dist/main.js",
	"type": "commonjs",
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": ">=26.0.0"
	},
	"scripts": {
		"start": "node dist/main.js",
		"build": "tsc",
		"dev": "pnpm build && pnpm start",
		"clean": "rm -rf dist",
		"prebuild": "pnpm run clean",
		"lint": "biome lint src && oxlint src --deny-warnings",
		"format": "oxfmt src",
		"format:check": "oxfmt --check src"
	},
	"keywords": [
		"telegram",
		"bot",
		"reminders",
		"cron"
	],
	"author": "adrianvillanueva997",
	"license": "GPL-3.0",
	"dependencies": {
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/api-logs": "^0.212.0",
		"@opentelemetry/auto-instrumentations-node": "^0.70.1",
		"@opentelemetry/core": "^2.12.1",
		"@opentelemetry/exporter-logs-otlp-grpc": "^0.212.0",
		"@opentelemetry/exporter-metrics-otlp-grpc": "^0.212.0",
		"@opentelemetry/exporter-trace-otlp-grpc": "^0.212.0",
		"@opentelemetry/resources": "^2.12.1",
		"@opentelemetry/sdk-logs": "^0.212.0",
		"@opentelemetry/sdk-metrics": "^2.12.1",
		"@opentelemetry/sdk-node": "^0.212.0",
		"@opentelemetry/sdk-trace-node": "^2.12.1",
		"@opentelemetry/semantic-conventions": "^1.45.0",
		"@opentelemetry/winston-transport": "^0.22.0",
		"cron": "^4.4.2",
		"telegraf": "^4.16.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.2",
		"@types/node": "26.6.6",
		"@types/node-fetch": "^2.6.13",
		"oxfmt": "0.79.0",
		"oxlint": "1.94.0",
		"typescript": "7.0.2"
	}
}
